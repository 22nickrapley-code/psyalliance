# Demo site build settings. Copy to .env.demo (never commit it).
# These are public values (they end up in the browser bundle); no secrets.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE-demo-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_with_the_demo_project_publishable_key
NEXT_PUBLIC_SITE_URL=https://psyalliance-demo.REPLACE.workers.dev
# Where "Ask to join" on the demo points: the real site.
NEXT_PUBLIC_REAL_SITE_URL=https://psyalliance.org
