# Supabase - find both on the Supabase dashboard: Project Settings -> API.
# Both are public-safe (the anon/"publishable" key is designed to be exposed
# in a browser bundle - Row Level Security is what actually protects the
# data), so these are also exactly what goes into wrangler.jsonc's "vars"
# for the Cloudflare Worker deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never used by this app's own code (every query goes through the RLS-scoped
# anon client above) - leave blank unless a future admin/backend job
# specifically needs to bypass RLS. If ever set, it must stay server-only
# and never be prefixed NEXT_PUBLIC_ or added to wrangler.jsonc's "vars".
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Once the production domain is live (Cloudflare custom domain, or
# the default *.workers.dev URL), set this so password-reset and
# email-confirmation links always point at the right place. Without it, the
# app falls back to building the link from the incoming request's own host,
# which works fine for local dev and previews - this just makes prod explicit.
NEXT_PUBLIC_SITE_URL=

# Set to "true" once real patient-identifying data is permitted to enter the system
# and the Supabase HIPAA add-on (Team plan, $599/mo+) + Cloudflare Enterprise BAA are signed.
# Until then, keep false - MVP data model must stay de-identified.
HIPAA_MODE_ENABLED=false
